# EdSharp .gitattributes
# EdSharp is a Windows project: keep text files in CRLF form on checkout and
# mark binary assets so git never tries to normalize them.
* text=auto eol=crlf

# Skrypty wykonywane przez WSL/Linux MUSZA zostac LF; CRLF psuje shebang
# interpretera. Wyjatek dodany dla build_installer_garfield.sh.
*.sh text eol=lf

*.ico binary
*.dll binary
*.exe binary
*.png binary
*.nvda-addon binary
*.gz binary
# Preserve empty final columns in raw measurement tables/transcripts.
/testy/wyniki/synonyms119/*.tsv whitespace=-blank-at-eol
/testy/wyniki/synonyms119/*.log whitespace=-blank-at-eol
